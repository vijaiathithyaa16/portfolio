# Copy this file to .env and fill in your real values.
# Locally (e.g. via Postgres.app / docker), or paste the DATABASE_URL Railway gives you.

DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
PORT=5000

# Comma-separated list of origins allowed to call this API (your deployed frontend URL(s))
CORS_ORIGIN=http://localhost:5500,https://your-frontend.vercel.app
